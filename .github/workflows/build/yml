name: Build IPA

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup Theos
        uses: hbang/theos-action@v1
      - name: Build
        run: make package
      - name: Upload IPA
        uses: actions/upload-artifact@v4
        with:
          name: LiveSubtitle.ipa
          path: packages/*.ipa
